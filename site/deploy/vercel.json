{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "public",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/:file(.*\\.md)",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/~gitbook/icon/",
      "destination": "/assets/sourcescan.png"
    },
    {
      "source": "/~gitbook/image/",
      "has": [
        {
          "type": "query",
          "key": "url",
          "value": "https://3353735212-files\\.gitbook\\.io/.*bafkreihbwe3aj2pnzoy6vaqbalps53xvq7xsqrip2t2jyt37zkj3nj4uhm\\.png(?:\\?.*)?"
        }
      ],
      "destination": "/assets/sourcescan.png"
    }
  ]
}
